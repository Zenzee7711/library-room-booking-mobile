# Copy to .env and fill in for your machine: cp .env.example .env

# HTTP
PORT=3000

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_room_booking

# Signs the JWTs handed to the app. Use a long random string in any deployed
# environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Timezone used for "today" and for slot cut-off times
APP_TIMEZONE=Asia/Bangkok

# Comma-separated allowed origins. Leave empty to accept any origin, which is
# what a mobile client needs in development.
CORS_ORIGINS=
